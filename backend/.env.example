# ==========================================
# WikiWish Environment Configuration
# ==========================================

# Environment Mode ('development' or 'production')
NODE_ENV=production

# Server Port (Toolforge standard container port is 8000 or 8080)
PORT=8000

# ------------------------------------------
# Wikimedia OAuth 1.0a Credentials
# Register on Meta-Wiki at Special:OAuthConsumerRegistration/propose
# ------------------------------------------
OAUTH_CONSUMER_KEY=your_production_oauth_consumer_key
OAUTH_CONSUMER_SECRET=your_production_oauth_consumer_secret

# OAuth Callback URL (where Wikimedia redirects after authorization)
# On Toolforge: https://<your-tool-name>.toolforge.org/api/auth/callback
# In Local Dev: http://localhost:8080/api/auth/callback
OAUTH_CALLBACK_URL=https://wikiwish.toolforge.org/api/auth/callback

# Frontend URL
# On Toolforge: https://<your-tool-name>.toolforge.org
# In Local Dev: http://localhost:3000
FRONTEND_URL=https://wikiwish.toolforge.org

# Session Encryption Secret (generate a strong random secret: openssl rand -hex 32)
SESSION_SECRET=generate_a_random_32_character_secret_here

# Allowed CORS Origins
CORS_ORIGINS=https://wikiwish.toolforge.org,http://localhost:3000
